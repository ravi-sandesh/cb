{
  "name": "choka-barah-web",
  "version": "1.0.0",
  "description": "Chowka Bara web version with unit tests",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "serve": "node server.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "moduleFileExtensions": [
      "js"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "collectCoverageFrom": [
      "game-engine.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "html",
      "lcov"
    ]
  }
}
