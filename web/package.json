{
  "name": "choka-barah-web",
  "version": "1.0.0",
  "description": "Chowka Bara web version with unit tests",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:gate": "node scripts/coverage-gate-diff.js",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "serve": "node server.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "moduleFileExtensions": [
      "js"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "collectCoverageFrom": [
      "app.js",
      "game-engine.js",
      "server.js",
      "sound.js",
      "telemetry.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 88,
        "branches": 90,
        "functions": 85,
        "lines": 90
      },
      "app.js": {
        "statements": 92,
        "branches": 90,
        "functions": 88,
        "lines": 93
      },
      "game-engine.js": {
        "statements": 95,
        "branches": 90,
        "functions": 95,
        "lines": 95
      },
      "server.js": {
        "statements": 55,
        "branches": 90,
        "functions": 30,
        "lines": 50
      },
      "sound.js": {
        "statements": 95,
        "branches": 90,
        "functions": 95,
        "lines": 95
      },
      "telemetry.js": {
        "statements": 75,
        "branches": 90,
        "functions": 70,
        "lines": 85
      }
    },
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "html",
      "lcov"
    ]
  }
}
