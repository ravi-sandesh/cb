{
  "name": "choka-barah-web",
  "version": "1.0.0",
  "description": "Chowka Bara web version with unit tests",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:gate": "node scripts/coverage-gate-diff.js",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "serve": "node server.js",
    "online": "node online/online-server.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "moduleFileExtensions": [
      "js"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "collectCoverageFrom": [
      "app.js",
      "game-engine.js",
      "server.js",
      "sound.js",
      "telemetry.js",
      "online-client.js",
      "online/**/*.js",
      "!online/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 88,
        "branches": 86,
        "functions": 85,
        "lines": 90
      },
      "app.js": {
        "statements": 92,
        "branches": 90,
        "functions": 88,
        "lines": 93
      },
      "game-engine.js": {
        "statements": 95,
        "branches": 90,
        "functions": 95,
        "lines": 95
      },
      "server.js": {
        "statements": 55,
        "branches": 90,
        "functions": 30,
        "lines": 50
      },
      "sound.js": {
        "statements": 95,
        "branches": 90,
        "functions": 95,
        "lines": 95
      },
      "telemetry.js": {
        "statements": 75,
        "branches": 90,
        "functions": 70,
        "lines": 85
      },
      "online/auth.js": {
        "statements": 88,
        "branches": 85,
        "functions": 95,
        "lines": 95
      },
      "online/game-server.js": {
        "statements": 94,
        "branches": 88,
        "functions": 95,
        "lines": 95
      },
      "online/online-db.js": {
        "statements": 95,
        "branches": 45,
        "functions": 95,
        "lines": 95
      },
      "online/online-server.js": {
        "statements": 80,
        "branches": 70,
        "functions": 85,
        "lines": 82
      },
      "online/relay.js": {
        "statements": 50,
        "branches": 40,
        "functions": 60,
        "lines": 65
      },
      "online/ws.js": {
        "statements": 80,
        "branches": 70,
        "functions": 75,
        "lines": 82
      },
      "online-client.js": {
        "statements": 90,
        "branches": 78,
        "functions": 90,
        "lines": 90
      }
    },
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "html",
      "lcov",
      "json"
    ]
  }
}
